#!/bin/bash
# Runs once on first boot (Amazon Linux 2023)
set -eux

dnf install -y amazon-cloudwatch-agent

# ---- A fake application that writes a log line every 5 seconds ----
cat > /usr/local/bin/p17-logger.sh <<'LOGGER'
#!/bin/bash
i=0
while true; do
  i=$((i+1))
  if [ $((i % 10)) -eq 0 ]; then
    level=ERROR; msg="payment service timeout (simulated)"
  elif [ $((i % 4)) -eq 0 ]; then
    level=WARN; msg="slow response (simulated)"
  else
    level=INFO; msg="request processed"
  fi
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $level app: $msg id=$i" >> /var/log/p17-app.log
  sleep 5
done
LOGGER
chmod +x /usr/local/bin/p17-logger.sh

cat > /etc/systemd/system/p17-logger.service <<'UNIT'
[Unit]
Description=Fake application that writes logs

[Service]
ExecStart=/usr/local/bin/p17-logger.sh
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now p17-logger

# ---- CloudWatch agent configuration: which files go to which log group ----
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CFG'
{
  "agent": { "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/p17-app.log",
            "log_group_name": "${app_log_group}",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "${system_log_group}",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
CFG

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
